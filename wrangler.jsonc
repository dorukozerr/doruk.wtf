{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doruk-wtf",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    { "pattern": "doruk.wtf", "custom_domain": true },
    { "pattern": "www.doruk.wtf", "custom_domain": true }
  ],
  "r2_buckets": [{ "binding": "WTFDORUK_BUCKET", "bucket_name": "wtfdoruk", "remote": true }]
}
